# ── Generated data ────────────────────────────────────────────────────────────
# TPC-H Parquet files are generated locally by scripts/generate_data.py.
# They are large (~1 GB total) and fully reproducible — no need to commit them.
data/

# ── Environment ───────────────────────────────────────────────────────────────
# Contains real credentials — never committed.
.env

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/

# ── Jupyter ───────────────────────────────────────────────────────────────────
# Local checkpoint files — regenerated by JupyterLab automatically.
.ipynb_checkpoints/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
